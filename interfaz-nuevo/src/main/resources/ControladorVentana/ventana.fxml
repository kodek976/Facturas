<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="540.0" prefWidth="600.0"
            style="-fx-background-color: #0EA1CF;"
            stylesheets="@stylesheetEmpresaNoFraudulenta.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ControladorVentana.HelloController">
    <children>
        <VBox layoutX="14.0" layoutY="14.0" prefHeight="512.0" prefWidth="569.0" style="-fx-background-color: white;" />

        <!-- TÍTULO -->
        <Label layoutX="200.0" layoutY="30.0" styleClass="label-title" text="Generar Factura" />
        <Label layoutX="175.0" layoutY="75.0" styleClass="label-subtitle" text="Introduce los datos del inquilino" />

        <!-- CAMPOS -->
        <Label layoutX="50.0" layoutY="122.0" styleClass="label-field" text="Nombre empresa:" />
        <TextField fx:id="textoNombre"    layoutX="230.0" layoutY="115.0" prefWidth="200.0" />

        <Label layoutX="50.0" layoutY="167.0" styleClass="label-field" text="CIF:" />
        <TextField fx:id="textoCif"       layoutX="230.0" layoutY="160.0" prefWidth="200.0" />

        <Label layoutX="50.0" layoutY="212.0" styleClass="label-field" text="Fecha (dd/mm/aaaa):" />
        <TextField fx:id="textoFecha"     layoutX="230.0" layoutY="205.0" prefWidth="200.0" promptText="01/05/2025" />

        <Label layoutX="50.0" layoutY="257.0" styleClass="label-field" text="Renta (€):" />
        <TextField fx:id="textoRenta"     layoutX="230.0" layoutY="250.0" prefWidth="200.0" promptText="0,00" />

        <Label layoutX="50.0" layoutY="302.0" styleClass="label-field" text="Comunidad (€):" />
        <TextField fx:id="textoComunidad" layoutX="230.0" layoutY="295.0" prefWidth="200.0" promptText="0,00" />

        <Label layoutX="50.0" layoutY="347.0" styleClass="label-field" text="Otros conceptos (€):" />
        <TextField fx:id="textoOtros"     layoutX="230.0" layoutY="340.0" prefWidth="200.0" promptText="0,00" />

        <!-- MENSAJE DE ESTADO -->
        <Label fx:id="labelMensaje" layoutX="50.0" layoutY="400.0" prefWidth="500.0" styleClass="label-field" text="" />

        <!-- BOTÓN -->
        <Button fx:id="botonConfirmar" layoutX="225.0" layoutY="450.0"
                onAction="#confirmar" styleClass="button-confirm" text="Generar Factura" />
    </children>
</AnchorPane>
